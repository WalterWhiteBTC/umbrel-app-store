global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["prometheus:9090"]
        labels:
          instance: "theoule-prometheus"
          site: "theoule"
          role: "monitoring"

  - job_name: "node"
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          instance: "theoule-umbrel"
          site: "theoule"
          role: "principal"
